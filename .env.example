# Copy to .env to override defaults (docker compose reads .env automatically).
# Every value here has a working default baked into docker-compose.yml, so
# docker compose up works with none of this set.

DEBUG=True
SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=*

DB_NAME=sous
DB_USER=sous
DB_PASSWORD=sous

# Optional: enables real AI categorisation via the Anthropic API.
# Without it, the app falls back to a deterministic keyword categoriser
# (see docs/PLAN.md / README "Trade-offs").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
